diff --git forkSrcPrefix/src/modules/reports/utils/finance.ts forkDstPrefix/src/modules/reports/utils/finance.ts
index 1a5aba0b1c94180c611ce802d5258326dca839f9..1bdf630e10af3b5138c3c4e337bbb172aa53eafd 100644
--- forkSrcPrefix/src/modules/reports/utils/finance.ts
+++ forkDstPrefix/src/modules/reports/utils/finance.ts
@@ -166,3 +166,76 @@ export function cellStyle(params: ValueFormatterParams) {
   }
   return { width: '100%' }
 }
+
+export function financialDisplayBalanceExportValue(
+  params: ValueFormatterParams
+) {
+  const node = params?.node
+  const groupData = getFinancialGroupBalanceData(node)
+
+  if (node && node.allChildrenCount != null && node.uiLevel === 0) {
+    return ''
+  }
+
+  if (
+    node?.allChildrenCount != null &&
+    node.uiLevel != null &&
+    node.uiLevel >= 1 &&
+    groupData?.group_balance != null
+  ) {
+    return formatFinanceExportValue(
+      groupData.parent_of_coa?.balance,
+      groupData.group_balance
+    )
+  }
+
+  return formatFinanceExportValue(
+    params.data?.balance,
+    params.data?.display_balance ?? params.valueFormatted ?? params.value
+  )
+}
+
+function getFinancialGroupBalanceData(node: any) {
+  return (
+    node?.childrenAfterFilter?.find(
+      (child: any) => child?.data?.group_balance != null
+    )?.data ||
+    node?.allLeafChildren?.find(
+      (child: any) => child?.data?.group_balance != null
+    )?.data
+  )
+}
+
+function formatFinanceExportValue(value: unknown, displayValue?: unknown) {
+  const display =
+    displayValue === undefined || displayValue === null
+      ? ''
+      : String(displayValue).trim()
+
+  if (display === '' || display === '-') {
+    return display
+  }
+
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return formatFinanceExportAmount(value)
+  }
+
+  const text = String(value ?? display).trim()
+  const isNegative = text.includes('(') || text.startsWith('-')
+  const numeric = Number(text.replace(/[(),]/g, '').replace(/[^\d.-]/g, ''))
+
+  if (!Number.isFinite(numeric)) {
+    return display
+  }
+
+  return formatFinanceExportAmount(isNegative ? -Math.abs(numeric) : numeric)
+}
+
+function formatFinanceExportAmount(value: number) {
+  if (value === 0) {
+    return '-'
+  }
+
+  const amount = Math.abs(value).toFixed(2)
+  return value < 0 ? `(${amount})` : amount
+}
