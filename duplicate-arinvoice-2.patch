 ]
diff --git a/src/modules/account-receivable/views/transaction/invoice/components/Form.vue b/src/modules/account-receivable/views/transaction/invoice/components/Form.vue
index 6454792..1be944a 100644
--- a/src/modules/account-receivable/views/transaction/invoice/components/Form.vue
+++ b/src/modules/account-receivable/views/transaction/invoice/components/Form.vue
@@ -771,6 +771,39 @@
     }
   }
 
+  async function updateExchangeRate() {
+    if (!formData.value.currency?.id || !formData.value.rate_category?.id) {
+      formData.value.exchange_rate = null
+      formData.value.gdt_exchange_rate = null
+      formData.value.rate_reciprocal = null
+      return
+    }
+
+    try {
+      const { data } = await accountReceivableService.getRateCategoryByCurrencyId({
+        from_currency_id: formData.value.currency.id,
+      })
+      const latestRateCategory = data.results.find((rateCategory) => rateCategory.id === formData.value.rate_category?.id)
+
+      if (!latestRateCategory) {
+        formData.value.exchange_rate = null
+        formData.value.gdt_exchange_rate = null
+        formData.value.rate_reciprocal = null
+        return
+      }
+
+      formData.value.rate_category = latestRateCategory
+      formData.value.exchange_rate = latestRateCategory.rate_value ?? null
+      formData.value.gdt_exchange_rate = latestRateCategory.rate_value ?? null
+      formData.value.rate_reciprocal = latestRateCategory.rate_reciprocal ?? null
+    } catch (error) {
+      console.error('Error updating exchange rate:', error)
+      formData.value.exchange_rate = null
+      formData.value.gdt_exchange_rate = null
+      formData.value.rate_reciprocal = null
+    }
+  }
+
   function onCreatePayment() {
     const route = router.resolve({
       name: 'account-receivable-payment.create',
@@ -898,6 +931,7 @@
             )
             formData.value.financial_period = await findCurrentFinancialPeriod()
             await updateDueDate()
+            await updateExchangeRate()
           }
         } else {
           const storage = onGetStorage(INVOICE_KEY)
