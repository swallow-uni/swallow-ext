+    const getS3UploadUrl = (response: any) => {
+        const uploadedFile = Array.isArray(response?.data?.file) ? response.data.file[0] : response?.data?.file
+
+        return uploadedFile?.url
+    }
+
+    const uploadToS3 = async (file: Blob, fileName?: string) => {
+        const formData = new FormData()
+
+        formData.append('file', file, fileName || 'editor-image')
+        formData.append('response_type', 'full')
+
+        const response = await fileServices.uploadS3(formData)
+        const url = getS3UploadUrl(response)
+
+        if (!url) {
+            throw new Error('Image upload failed: missing uploaded file URL')
+        }
+
+        return url
+    }
+
+    const uploadImageToS3 = async (blobInfo: any) => {
+        return uploadToS3(blobInfo.blob(), blobInfo.filename?.())
+    }
+
+    const pickImageAndUploadToS3 = (callback: (url: string, meta?: Record<string, string>) => void) => {
+        const input = document.createElement('input')
+
+        input.type = 'file'
+        input.accept = 'image/*'
+        input.onchange = async () => {
+            const file = input.files?.[0]
+
+            if (!file) return
+
+            const url = await uploadToS3(file, file.name)
+
+            callback(url, {
+                title: file.name,
+                alt: file.name,
+            })
+        }
+
+        input.click()
+    }
+
+    const escapeHtmlAttribute = (value = '') => {
+        return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    }
+
+    const insertImage = (editor: any, url: string, alt = '') => {
+        editor.insertContent(
+            `<img src="${escapeHtmlAttribute(url)}" alt="${escapeHtmlAttribute(alt)}" crossorigin="anonymous">`
+        )
+    }
+
+    const pickImageAndInsertToEditor = (editor: any) => {
+        pickImageAndUploadToS3((url, meta) => {
+            insertImage(editor, url, meta?.alt)
+        })
+    }
+
+    const getImageFiles = (fileList?: FileList | null) => {
+        if (!fileList) return []
+
+        return Array.from(fileList).filter(file => file.type.startsWith('image/'))
+    }
+
+    const getClipboardImageFiles = (clipboardData?: DataTransfer | null) => {
+        const files = getImageFiles(clipboardData?.files)
+
+        if (files.length || !clipboardData?.items) return files
+
+        return Array.from(clipboardData.items)
+            .filter(item => item.kind === 'file' && item.type.startsWith('image/'))
+            .map(item => item.getAsFile())
+            .filter((file): file is File => !!file)
+    }
+
+    const uploadAndInsertImages = async (editor: any, files: File[]) => {
+        for (const file of files) {
+            const url = await uploadToS3(file, file.name)
+
+            insertImage(editor, url, file.name)
+        }
+    }
+
+    const setAnonymousCrossOrigin = (root: any) => {
+        root?.querySelectorAll('img').forEach(img => {
+            img.setAttribute('crossorigin', 'anonymous')
+        })
+    }
