+const mapJobOfferJobAppliedApplicants = (items: any[] = []): TJobAppliedApplicant[] => {
+    return items.map(item => {
+        const jobAppliedInfo = typeof item.job_applied === 'object' ? item.job_applied : item.job_applied_info
+        const hrEmployeeInfo = typeof item.hr_employee === 'object' ? item.hr_employee : null
+
+        return {
+            ...item,
+            job_applied: jobAppliedInfo?.id ?? item.job_applied,
+            pipeline: item.pipeline_info ?? item.pipeline ?? null,
+            pipeline_info: item.pipeline_info ?? item.pipeline ?? null,
+            hr_employee: item.hr_employee_info?.hr_employee ?? hrEmployeeInfo?.id ?? item.hr_employee ?? null,
+            hr_employee_info:
+                item.hr_employee_info ??
+                (hrEmployeeInfo
+                    ? {
+                          hr_employee: hrEmployeeInfo.id,
+                          hr_employee_full_name: hrEmployeeInfo.full_name,
+                      }
+                    : null),
+            hr_employee_onbehalf: item.hr_employee_onbehalf?.id ?? item.hr_employee_onbehalf,
+            tag_manager:
+                item.tag_manager?.map((manager: any) => ({
+                    id: manager.hr_employee?.id ?? manager.id,
+                    hr_employee: manager.hr_employee,
+                    active: manager.active,
+                })) ?? [],
+            job_applied_applicant_benefit_allowances:
+                item.job_applied_applicant_benefit_allowances?.map((allowance: any) => ({
+                    ...allowance,
+                    allowance: allowance.allowance ?? {
+                        code: allowance.code,
+                        name: allowance.name,
+                    },
+                })) ?? [],
+            is_new: item.is_new ?? false,
+            applied_from: item.applied_from?.id ?? item.applied_from ?? null,
+            job_type: item.job_type ?? jobAppliedInfo?.job_type,
+            announcement_code: item.announcement_code ?? jobAppliedInfo?.announcement_code ?? jobAppliedInfo?.code,
+            position_name:
+                item.position_name ?? jobAppliedInfo?.position_name ?? jobAppliedInfo?.job_code?.position_info?.name,
+        } as TJobAppliedApplicant
+    })
+}
+
+const mapJobOfferApplicantInfo = (applicant: any): IApplicantFormData => {
+    return {
+        ...applicant,
+        religion: applicant?.religion_info?.id,
+        blood_type: applicant?.blood_type_info?.id,
+        marital_status: applicant?.marital_status_info?.id,
+        gender: applicant?.gender_info?.id ?? applicant?.gender,
+        applicant_document:
+            applicant?.applicant_document?.map((doc: any) => ({
+                ...doc,
+                name: doc.type_info?.name,
+            })) ?? [],
+        applicant_family:
+            applicant?.applicant_family?.map((family: any) => ({
+                ...family,
+                id: family.id,
+                full_name: family.full_name,
+                gender: family.family_gender_info,
+                nationality: family.nationality_info,
+                relationship: family?.family_relationship_info,
+            })) ?? [],
+        job_applied_applicants: mapJobOfferJobAppliedApplicants(
+            applicant?.job_applied_applicants ?? applicant?.job_applied_applicant ?? []
+        ),
+    } as IApplicantFormData
+}
