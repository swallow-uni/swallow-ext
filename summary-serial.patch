+function resetSerialFilterMessages() {
+  serialFilterMessage.value = {
+    warehouse: '',
+    items: '',
+  }
+}
+
+function hasSelectedValue(value: unknown) {
+  return Array.isArray(value) ? value.length > 0 : Boolean(value)
+}
+
+function validateSerialFilters() {
+  resetSerialFilterMessages()
+
+  if (!includeSerial.value) {
+    return true
+  }
+
+  if (!hasSelectedValue(store.warehouse)) {
+    serialFilterMessage.value.warehouse = 'Please select warehouse'
+  }
+
+  if (!hasSelectedValue(store.items)) {
+    serialFilterMessage.value.items = 'Please select inventory item'
+  }
+
+  return (
+    !serialFilterMessage.value.warehouse && !serialFilterMessage.value.items
+  )
+}
+
