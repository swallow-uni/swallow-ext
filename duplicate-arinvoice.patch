+import { v4 as uuidv4 } from 'uuid'
+import { duplicateFormObject } from '@/helpers/form_helper'
+import { accountReceivableInvoicePure } from '@@/account-receivable/services/account-receivable-invoice.service'
+import type {
+  AccountReceivableFormData,
+  AccountReceivableReadResponseTransformed,
+  ItemDetailTransformed,
+} from '@@/account-receivable/types/account-receivable-invoice.type'
+
+export const ACCOUNT_RECEIVABLE_DUPLICATE_STORAGE_KEY = 'accountReceivableDuplicateId'
+
+type AccountReceivableTransactionType = 'invoice' | 'sale_invoice'
+
+const duplicateItemDetailOmitKeys = ['id', 'uuid', 'object_id', 'content_type', 'item_detail_taxes']
+
+const duplicateAccountReceivableOmitKeys = [
+  'id',
+  'reference_no',
+  'create_date',
+  'file_counts',
+  'files',
+  'file',
+  'file_info',
+  'file_delete',
+  'detail_taxes',
+  'payment_applications',
+  'payment_state',
+  'prepayment_amount',
+  'total_after_discount',
+  'total_balance',
+  'total_open_balance',
+  'total_tax',
+  'total_tax_incl',
+  'total_untaxed',
+  'state',
+  'status',
+  'journal',
+  'actions',
+  'object_id',
+  'content_type',
+  'external_reference',
+  'is_correction',
+  'parent',
+]
+
+export function useAccountReceivableDuplicate() {
+  function createDuplicateItemDetail(itemDetail: ItemDetailTransformed): ItemDetailTransformed {
+    return {
+      ...accountReceivableInvoicePure.createItemDetail(),
+      ...duplicateFormObject(itemDetail, { omitKeys: duplicateItemDetailOmitKeys }),
+      uuid: uuidv4(),
+    }
+  }
+
+  function createDuplicateAccountReceivableFormData(
+    data: AccountReceivableReadResponseTransformed,
+    transactionType: AccountReceivableTransactionType
+  ): AccountReceivableFormData {
+    return {
+      ...accountReceivableInvoicePure.createAccountReceivableFormData({ transactionType }),
+      ...duplicateFormObject(data, { omitKeys: duplicateAccountReceivableOmitKeys }),
+      item_details: (data.item_details ?? []).map(createDuplicateItemDetail),
+    }
+  }
+
+  return {
+    createDuplicateAccountReceivableFormData,
+  }
+}
