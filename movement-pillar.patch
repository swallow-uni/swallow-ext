+const hasOwnKey = (source: any, key: string) => Boolean(source && Object.hasOwn(source, key))
+
+const cloneValue = (value: any) => {
+    if (value === undefined || value === null) return null
+    return typeof value === 'object' ? { ...value } : value
+}
+
+const getValueId = (value: any) => {
+    if (value === undefined || value === null) return null
+    return typeof value === 'object' ? value.id ?? null : value
+}
+
+const getRequesterMovementValue = (hrRequesterInfo: any, key: string) => {
+    if (!hrRequesterInfo || !key) return null
+
+    if (key === 'division') return hrRequesterInfo.unit_info
+
+    const infoKey = `${key}_info`
+    return hasOwnKey(hrRequesterInfo, infoKey) ? hrRequesterInfo[infoKey] : hrRequesterInfo[key]
+}
+
+export const mapMovementDefaultValue = (hrRequesterInfo: any, key: string) => {
+    let value = cloneValue(getRequesterMovementValue(hrRequesterInfo, key))
+
+    if (['horizontal_report_to', 'report_to'].includes(key) && value && typeof value === 'object') {
+        value = {
+            ...value,
+            ...(value.job !== undefined && { position: value.job }),
+        }
+        value = object.isEmpty(value) ? null : value
+    }
+
+    if (key === 'job_code' && value && typeof value === 'object') {
+        value = {
+            ...value,
+            ...(value.name && { name: value.position_name }),
+            job_grade: hrRequesterInfo?.job_grade_info?.id,
+            job_grade_name: hrRequesterInfo?.job_grade_info?.name,
+        }
+    }
+
+    const valueId = getValueId(value)
+
+    return {
+        from_value_object: cloneValue(value),
+        from_value_id: valueId,
+        to_value_object: cloneValue(value),
+        to_value_id: valueId,
+    }
+}
