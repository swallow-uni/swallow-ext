index 0000000000..ed7b5e7eba
--- /dev/null
+++ b/src/modules/requests/types/overtime/priority-ordering.type.ts
@@ -0,0 +1,42 @@
+type TCompensationType = 'percentage' | 'amount' | 'leave'
+
+export type PriorityOrderingType = {
+    sequence: number
+    compensation_type: TCompensationType
+}
+
+export type PriorityOrderingFormData = PriorityOrderingType[]
+export type PriorityOrderingPayloadType = PriorityOrderingType & {
+    id?: number
+}
+export type PriorityOrderingPayloadData = PriorityOrderingPayloadType[]
+export type PriorityOrderingResponseType = PriorityOrderingType & {
+    id: number
+}
+export type PriorityOrderingResponseData = PriorityOrderingResponseType[]
+
+export const PriorityOrderingPure = {
+    createFormData: (): PriorityOrderingFormData => {
+        return [
+            {
+                sequence: 1,
+                compensation_type: 'percentage',
+            },
+            {
+                sequence: 2,
+                compensation_type: 'amount',
+            },
+            {
+                sequence: 3,
+                compensation_type: 'leave',
+            },
+        ]
+    },
+    createPayload: (formData: PriorityOrderingPayloadData): PriorityOrderingPayloadData => {
+        return formData.map(item => ({
+            ...(item.id !== undefined ? { id: item.id } : {}),
+            sequence: item.sequence,
+            compensation_type: item.compensation_type,
+        }))
+    },
+}
