diff --git a/src/modules/requests/views/configuration/overtime-settings/priority-order/form.vue b/src/modules/requests/views/configuration/overtime-settings/priority-order/form.vue
new file mode 100644
index 0000000000..b0d9cf2833
--- /dev/null
+++ b/src/modules/requests/views/configuration/overtime-settings/priority-order/form.vue
@@ -0,0 +1,125 @@
+<template>
+    <base-form
+        v-model="formData"
+        :title="$t('configuration_overtime_setting.title')"
+        :editing-id="editingId"
+        :editing="editing"
+        :show-discard="false"
+        :simple-form="true"
+        :route-group="OvertimeConfigRouteName.OVERTIME_SETTINGS"
+        :linked-model="PRIORITY_ORDERING_CONTENT_TYPE"
+        :api-service="PriorityOrderingService"
+        :on-success="true"
+        @saved="saved"
+        @success.stop=""
+    >
+        <template #default="{ formMode }">
+            <p class="pb-4 font-weight-medium" style="font-size: 15px">
+                {{ $t('configuration_overtime_setting_priority_ordering.title') }}
+            </p>
+            <p class="pb-4 text-body-2 text-grey-darken-1">
+                {{ $t('configuration_overtime_setting_priority_ordering.user_guide') }}
+            </p>
+            <v-row>
+                <v-col cols="12">
+                    <v-table density="compact">
+                        <thead>
+                            <tr>
+                                <th style="width: 120px">
+                                    {{ $t('configuration_overtime_setting_priority_ordering.priority') }}
+                                </th>
+                                <th>{{ $t('configuration_overtime_setting_priority_ordering.compensation_type') }}</th>
+                            </tr>
+                        </thead>
+                        <draggable
+                            v-model="formData"
+                            tag="tbody"
+                            item-key="compensation_type"
+                            :disabled="formMode === 'view'"
+                            @change="refreshSequence"
+                        >
+                            <template #item="{ element: item, index }">
+                                <tr :class="[formMode === 'view' ? 'cursor-default' : 'cursor-move']">
+                                    <td class="py-2">
+                                        <div class="d-flex align-center gap-2">
+                                            <v-icon v-if="formMode !== 'view'" icon="mdi-drag" size="small" />
+                                            <span class="priority-order-number">{{ index + 1 }}</span>
+                                        </div>
+                                    </td>
+                                    <td class="py-2">{{ getCompensationTypeLabel(item.compensation_type) }}</td>
+                                </tr>
+                            </template>
+                        </draggable>
+                    </v-table>
+                </v-col>
+            </v-row>
+        </template>
+    </base-form>
+</template>
+
+<script setup lang="ts">
+    import { onMounted, ref } from 'vue'
+    import draggable from 'vuedraggable'
+    import { PriorityOrderingService } from '@@/requests/services/configuration.service'
+    import { OvertimeConfigRouteName } from '@/modules/requests/router/route.name'
+    import { PRIORITY_ORDERING_CONTENT_TYPE } from '@@/requests/types/configuration'
+    import { PriorityOrderingPure } from '@@/requests/types/overtime/priority-ordering.type'
+    import type {
+        PriorityOrderingPayloadData,
+        PriorityOrderingType,
+    } from '@@/requests/types/overtime/priority-ordering.type'
+
+    const compensationTypeLabels: Record<PriorityOrderingType['compensation_type'], string> = {
+        percentage: 'Percentage',
+        amount: 'Amount',
+        leave: 'Compensatory Leave',
+    }
+
+    const emit = defineEmits(['saved'])
+    const formData = ref<PriorityOrderingPayloadData>(PriorityOrderingPure.createFormData())
+    const editing = ref(false)
+    const editingId = ref<number | null>(null)
+
+    async function get() {
+        const response = await PriorityOrderingService.get()
+        const data = response.data.results
+        if (!data.length) {
+            return
+        }
+        formData.value = data
+        refreshSequence()
+    }
+    function refreshSequence() {
+        formData.value = formData.value.map((item, index) => ({
+            ...item,
+            sequence: index + 1,
+        }))
+    }
+    function getCompensationTypeLabel(type: PriorityOrderingType['compensation_type']) {
+        return compensationTypeLabels[type]
+    }
+    function saved(formErrors: { formErrors: Record<string, any> }) {
+        if (Object.keys(formErrors.formErrors).length) {
+            return
+        }
+        emit('saved')
+    }
+    onMounted(() => {
+        get()
+    })
+</script>
+
+<style scoped>
+    .priority-order-number {
+        align-items: center;
+        background: rgb(var(--v-theme-surface-variant));
+        border-radius: 999px;
+        display: inline-flex;
+        font-size: 0.8125rem;
+        font-weight: 600;
+        height: 1.75rem;
+        justify-content: center;
+        min-width: 1.75rem;
+        padding: 0 0.5rem;
+    }
+</style>
