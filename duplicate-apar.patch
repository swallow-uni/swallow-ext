@@ -126,3 +126,24 @@ export const omitInfoFields = <T extends Record<string, any>>(
     })
   ) as Partial<T>
 }
+
+export const duplicateFormObject = <T extends object>(
+  data: T,
+  options: {
+    omitKeys?: string[]
+    omitPrefixes?: string[]
+  } = {}
+): T => {
+  const { omitKeys = [], omitPrefixes = [] } = options
+  const duplicateData = { ...data }
+  const keys = new Set(['formErrors', ...omitKeys])
+  const prefixes = ['display_', ...omitPrefixes]
+
+  Object.keys(duplicateData).forEach((key) => {
+    if (keys.has(key) || prefixes.some((prefix) => key.startsWith(prefix))) {
+      delete (duplicateData as Record<string, unknown>)[key]
+    }
+  })
+
+  return duplicateData
+}
