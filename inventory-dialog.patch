+import { ref } from 'vue'
+import { fileServices } from '@/atom/base/base.apis'
+import { len } from '@/utils/core'
+
+export const useInventoryDialogSubmit = ({
+    formData,
+    props,
+    store,
+    emit,
+    itemSerial,
+    activeTab,
+    isItemHasSerial,
+    selectedSerial,
+    isSelectedSerial,
+    dataUpload,
+    isWrongTemplate,
+    errorSerial,
+    hasCardNumber,
+    localAvailableQty,
+    emptyFormdata,
+    t,
+}) => {
+    const saveLoading = ref(false)
+    const errorMessage = ref({})
+    const confirmSaveQtyDialogRef = ref()
+
+    const validateForm = () => {
+        const { transaction_type } = props
+
+        const commonFields = {
+            id: formData.value?.id || undefined,
+            warehouse: formData.value.warehouse?.id,
+            location: formData.value.location?.id,
+            item: formData.value.item,
+            item_uom: formData.value.item_uom?.id,
+            serial_file: formData.value.serial_file,
+            description: formData.value.description,
+            action: formData.value.id ? 'update' : 'create',
+            external_reference: props?.external_reference,
+            external_type: props.external_type ?? props.transaction_type,
+            total_cost: formData.value.total_cost ?? 0,
+            txn_dtl_object_id: formData.value?.txn_dtl_object_id,
+            txn_dtl_content_type: formData.value?.txn_dtl_content_type,
+            unit_cost_base_uom: formData.value?.unit_cost_base_uom,
+            unit_cost_uom: formData.value?.unit_cost_uom,
+        }
+
+        switch (transaction_type) {
+            case 'receipt':
+                return {
+                    ...commonFields,
+                    quantity: formData.value.quantity,
+                    cost: formData.value.cost,
+                }
+            case 'issue':
+                return {
+                    ...commonFields,
+                    quantity: formData.value.quantity,
+                    cost: formData.value.cost,
+                    price: formData.value.price,
+                    card_number_file: formData.value.card_number_file,
+                    available_qty_uom: formData.value.available_qty_uom,
+                    allow_negative: formData.value.allow_negative,
+                }
+            case 'transfer':
+                return {
+                    ...commonFields,
+                    quantity: formData.value.quantity,
+                    cost: formData.value.cost,
+                    from_warehouse: formData.value.from_warehouse?.id,
+                    from_location: formData.value.from_location?.id,
+                    to_warehouse: formData.value.to_warehouse?.id,
+                    to_location: formData.value.to_location?.id,
+                    issue: formData.value.issue,
+                }
+            case 'transfer_request':
+                return {
+                    ...commonFields,
+                    request_qty: formData.value.request_qty,
+                    from_warehouse: props.fromWarehouse?.id,
+                    to_warehouse: props.toWarehouse?.id,
+                }
+            case 'adjustment':
+                return {
+                    ...commonFields,
+                    adjust_type: formData.value.adjust_type,
+                    adjust_qty: formData.value.adjust_qty,
+                    adjust_cost: formData.value.adjust_cost,
+                    fifo_transaction: formData.value.fifo_transaction ?? undefined,
+                }
+            default:
+                return {}
+        }
+    }
+
+    const uploadSelectedSerials = async () => {
+        if (!isItemHasSerial.value || props.transaction_type == 'transfer_request' || !len(selectedSerial.value)) return
+
+        let formFile = new FormData()
+        const serials =
+            typeof selectedSerial.value[0] === 'string'
+                ? selectedSerial.value
+                : selectedSerial.value.map(serialItem => serialItem.serial)
+
+        formFile.append('file', new File([JSON.stringify(serials)], 'item_serial.json', { type: 'application/json' }))
+        formFile.append('ref_type', 'inventory')
+        formFile.append('hr_employee', props.employee)
+
+        const res = await fileServices.create(formFile)
+        formData.value.serial_file = res.data[0].id
+
+        if (!hasCardNumber.value) return
+
+        formFile = new FormData()
+        formFile.append(
+            'file',
+            new File([JSON.stringify([...selectedSerial.value])], 'item_serial_cards.json', {
