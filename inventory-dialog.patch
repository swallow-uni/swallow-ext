+type InventoryDialogAction = 'create' | 'update'
+
+export const resolveInventoryDialogAction = (item, parentFormMode?: string): InventoryDialogAction => {
+    if (parentFormMode === 'create') return 'create'
+    return item?.id ? 'update' : 'create'
+}
+
+export const buildInventoryDialogFormData = (
+    item,
+    action: InventoryDialogAction = resolveInventoryDialogAction(item)
+) => ({
+    id: item?.id ?? undefined,
+    action,
+
+    item: item?.item,
+    item_info: item?.item_info,
+    item_uom: item?.item_uom_info,
+    isVariant: item?.isVariant ?? false,
+    is_track_serial: item?.is_track_serial,
+    require_serial: item?.require_serial,
+
+    warehouse: item?.warehouse_info,
+    location: item?.location_info,
+    from_warehouse: item?.from_warehouse_info,
+    to_warehouse: item?.to_warehouse_info,
+    from_location: item?.from_location_info,
+    to_location: item?.to_location_info,
+
+    quantity: item?.quantity,
+    request_qty: item?.request_qty ?? undefined,
+    cost: item?.cost,
+    total_cost: item?.total_cost ?? 0,
+    price: item?.price ?? undefined,
+    unit_cost_base_uom: item?.unit_cost_base_uom ?? 0,
+    unit_cost_uom: item?.unit_cost_uom ?? 0,
+    available_qty_uom: item?.available_qty_uom,
+    allow_negative: item?.allow_negative,
+
+    adjust_type: item?.adjust_type,
+    adjust_qty: item?.adjust_qty,
+    adjust_cost: item?.adjust_cost,
+    fifo_transaction: item?.fifo_transaction,
+    fifo_transaction_info: item?.fifo_transaction_info,
+
+    serial_file: item?.serial_file,
+    card_number_file: item?.card_number_file,
+    selectedSerial: item?.selectedSerial,
+
+    txn_dtl_object_id: item?.txn_dtl_object_id ?? null,
+    txn_dtl_content_type: item?.txn_dtl_content_type ?? null,
+    issue: item?.issue,
+    issue_info: item?.issue_info,
+    description: item?.description,
+})
diff --git a/src/modules/inventory/components/dialog/composables/useInventoryDialogSerialItems.ts b/src/modules/inventory/components/dialog/composables/useInventoryDialogSerialItems.ts
new file mode 100644
index 0000000000..dec1481b85
--- /dev/null
+++ b/src/modules/inventory/components/dialog/composables/useInventoryDialogSerialItems.ts
@@ -0,0 +1,185 @@
+import { nextTick, ref } from 'vue'
+import { DataUpload } from '@@/composables/useSerial'
+import object from '@/utils/object'
+
+export const useInventoryDialogSerialItems = ({
+    formData,
+    props,
+    store,
+    apiLookupService,
+    itemSerial,
+    serialStore,
+    serialRefs,
+    hasCardNumber,
+    isItemHasSerial,
+    valueProvider,
+    resetSelectedVariants,
+}) => {
+    const { isSelectAll, selectedSerial, isSelectedSerial, dataUpload } = serialRefs
+    const isLoadingSerialItem = ref(false)
+
+    const getSerial = async () => {
+        try {
+            isLoadingSerialItem.value = true
+            let currentPage = 1
+            const pageSize = 1000
+            let hasMoreData = true
+            const serialsSet: any = hasCardNumber.value ? new Map<string, DataUpload>() : new Set<string>()
+
+            if (hasCardNumber.value) {
+                dataUpload.value.forEach((item: DataUpload) => {
+                    serialsSet.set(item.serial, item)
+                })
+            } else {
+                dataUpload.value.forEach((serial: string) => {
+                    serialsSet.add(serial)
+                })
+            }
+
+            while (hasMoreData) {
+                const response = await apiLookupService.getItemSerial(
+                    {
+                        item: formData.value.item,
+                        paging: true,
+                        issue_detail_id:
+                            formData.value.txn_dtl_object_id && props.transaction_type === 'receipt'
+                                ? formData.value.txn_dtl_object_id
+                                : undefined,
+                        location: formData.value.from_location?.id ?? formData.value.location?.id ?? undefined,
+                    },
+                    {
+                        page: currentPage,
+                        page_size: pageSize,
+                    }
+                )
+
+                if (hasCardNumber.value) {
+                    response.data.results.forEach(item => {
+                        serialsSet.set(item.serial, new DataUpload({ serial: item.serial }))
+                    })
+                } else {
+                    response.data.results.forEach(item => {
+                        serialsSet.add(item.serial)
+                    })
+                }
+
+                if (currentPage % 3 === 0) {
+                    await nextTick()
+                }
+
+                hasMoreData = response.data.next !== null
+                currentPage++
+            }
+
+            dataUpload.value = hasCardNumber.value ? Array.from(serialsSet.values()) : Array.from(serialsSet)
+
+            if (dataUpload.value.length > 0) {
+                isSelectedSerial.value = true
+                formData.value.selectedSerial = true
+            }
+        } catch (error) {
+            console.error(error)
+        } finally {
+            isLoadingSerialItem.value = false
+        }
+    }
+
+    const fetchItemSerial = async () => {
+        if (
+            object.isEmpty(formData.value.txn_dtl_object_id) &&
+            object.isEmpty(formData.value.from_location) &&
+            object.isEmpty(formData.value.location) &&
+            store.formMode == 'view'
+        )
+            return
+        dataUpload.value = []
+        await getSerial()
+    }
+
+    const getItemSerial = async id => {
+        if (dataUpload.value.length !== 0) return
+        isLoadingSerialItem.value = true
+        try {
+            const res = await itemSerial.getItemSerialById(id, {})
+            let data = res.data
+            if (hasCardNumber.value) {
+                data = res.data.map(item => new DataUpload({ serial: item }))
+            }
+            isLoadingSerialItem.value = false
+            dataUpload.value = [...selectedSerial.value] = [...data]
+            if (!valueProvider.value && props.transaction_type !== 'transfer_request') {
+                if (data.length === 0) {
+                    resetSelectedVariants()
+                    await fetchItemSerial()
+                }
+            }
+
+            if ((isSelectedSerial.value || formData.value.selectedSerial) && store.formMode !== 'view') {
+                await getSerial()
+            }
+            await serialStore.onValidateSelectAll()
+        } catch (error) {
+            isLoadingSerialItem.value = false
+        }
+    }
+
+    const getItemSerialFromIssue = async id => {
+        if (dataUpload.value.length !== 0) return
+        isLoadingSerialItem.value = true
+        try {
+            const res = await itemSerial.getItemSerialByIssueId(id, { paging: false })
+            const data = res.data
+            isLoadingSerialItem.value = false
+            dataUpload.value = [...selectedSerial.value] = [
+                ...data.map(d => new DataUpload({ serial: d.serial, card_number: d.card_number })),
+            ]
+
+            if ((isSelectedSerial.value || formData.value.selectedSerial) && store.formMode !== 'view') {
+                await getSerial()
+            }
+            await serialStore.onValidateSelectAll()
+        } catch (error) {
+            isLoadingSerialItem.value = false
+        }
+    }
+
+    const getItemSerialAndCardNumber = async () => {
+        if (dataUpload.value.length !== 0) return
+        isLoadingSerialItem.value = true
+        try {
+            const { data: cardNumbers } = await itemSerial.getItemSerialById(formData.value.card_number_file, {})
+            isLoadingSerialItem.value = false
+            dataUpload.value = [...selectedSerial.value] = [
+                ...cardNumbers.map(card => new DataUpload({ serial: card.serial, card_number: card.card_number })),
+            ]
+
+            if ((isSelectedSerial.value || formData.value.selectedSerial) && store.formMode !== 'view') {
+                await getSerial()
+            }
+            await serialStore.onValidateSelectAll()
+        } catch (error) {
+            isLoadingSerialItem.value = false
+        }
+    }
+
+    const doFetchSerial = async () => {
+        if (!valueProvider.value && isItemHasSerial.value) {
+            await fetchItemSerial()
+        } else {
+            dataUpload.value = [...selectedSerial.value] = []
+        }
+    }
+
+    return {
+        isLoadingSerialItem,
+        isSelectAll,
+        selectedSerial,
+        isSelectedSerial,
+        dataUpload,
+        fetchItemSerial,
+        getItemSerial,
+        getItemSerialFromIssue,
+        getItemSerialAndCardNumber,
+        doFetchSerial,
+    }
+}
