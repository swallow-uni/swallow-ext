+import { v4 as uuidv4 } from 'uuid'
+import { duplicateFormObject } from '@/helpers/form_helper'
+import { accountPayableBillPure } from '@@/account-payable/services/account-payable-bill.service'
+import type {
+  AccountPayableFormData,
+  AccountPayableReadResponseTransformed,
+  ItemDetailTransformed,
+} from '@@/account-payable/types/account-payable-bill.type'
+
+export const ACCOUNT_PAYABLE_DUPLICATE_STORAGE_KEY = 'accountPayableDuplicateId'
+
+type AccountPayableTransactionType = 'account_payable_bill' | 'expense_bill'
+
+const duplicateItemDetailOmitKeys = ['id', 'uuid', 'object_id', 'content_type', 'item_detail_taxes']
+
+const duplicateAccountPayableOmitKeys = [
+  'id',
+  'reference_no',
+  'create_date',
+  'file_counts',
+  'files',
+  'file',
+  'file_info',
+  'file_delete',
+  'detail_taxes',
+  'payment_applications',
+  'payment_state',
+  'prepayment_amount',
+  'total_after_discount',
+  'total_balance',
+  'total_open_balance',
+  'total_tax',
+  'total_tax_incl',
+  'total_untaxed',
+  'state',
+  'status',
+  'journal',
+  'actions',
+  'object_id',
+  'content_type',
+  'external_reference',
+  'reversed_by',
+  'reversed_date',
+  'reverse_reason',
+  'grn_file_reference',
+]
+
+export function useAccountPayableDuplicate() {
+  function createDuplicateItemDetail(itemDetail: ItemDetailTransformed): ItemDetailTransformed {
+    return {
+      ...accountPayableBillPure.createItemDetail(),
+      ...duplicateFormObject(itemDetail, { omitKeys: duplicateItemDetailOmitKeys }),
+      uuid: uuidv4(),
+    }
+  }
+
+  function createDuplicateAccountPayableFormData(
+    data: AccountPayableReadResponseTransformed,
+    transactionType: AccountPayableTransactionType
+  ): AccountPayableFormData {
+    return {
+      ...accountPayableBillPure.createAccountPayableFormData({ transactionType }),
+      ...duplicateFormObject(data, { omitKeys: duplicateAccountPayableOmitKeys }),
+      item_details: (data.item_details ?? []).map(createDuplicateItemDetail),
+    }
+  }
+
+  return {
+    createDuplicateAccountPayableFormData,
+  }
+}
