@@ -0,0 +1,273 @@
+import flatMap from 'lodash/flatMap'
+import get from 'lodash/get'
+import XLSX from 'xlsx-js-style'
+import { IDENTIFIER } from '@@/reports/data/finance'
+
+interface SplitTreeDataExportParams {
+  autoGroupColumn: any
+  colDefs: any[]
+  fileName: string
+  gridApi: any
+  sheetName: string
+}
+
+export function getExportGroupLabel(value: unknown) {
+  return String(value ?? '')
+    .split(IDENTIFIER)[0]
+    .trim()
+}
+
+function getTreeExportTitle(autoGroupColumn: any, fallbackTitle: string) {
+  const headerName = autoGroupColumn?.headerName
+  if (typeof headerName === 'function') {
+    return headerName()
+  }
+  if (headerName && typeof headerName === 'object' && 'value' in headerName) {
+    return headerName.value
+  }
+  return headerName || fallbackTitle
+}
+
+function getTreeExportPath(node: any) {
+  if (Array.isArray(node?.data?.path)) {
+    return node.data.path
+  }
+
+  const leafPath = node?.allLeafChildren?.find((child: any) =>
+    Array.isArray(child?.data?.path)
+  )?.data?.path
+
+  if (Array.isArray(leafPath)) {
+    const level = Number.isInteger(node?.uiLevel)
+      ? node.uiLevel + 1
+      : leafPath.length
+    return leafPath.slice(0, level)
+  }
+
+  if (typeof node?.getRoute === 'function') {
+    const route = node.getRoute()
+    if (Array.isArray(route)) {
+      return route
+    }
+  }
+
+  const path = []
+  let current = node
+  while (current?.key != null) {
+    path.unshift(current.key)
+    current = current.parent
+  }
+
+  return path
+}
+
+function getTreeExportValueColumn(colDefs: any[]) {
+  const columns = flatMap(colDefs, (item: any) => item.children || item)
+  return (
+    columns.find((item: any) => item.field === 'display_balance') ||
+    columns.find((item: any) => typeof item.exportValueGetter === 'function')
+  )
+}
+
+function getTreeExportRenderedValue(colDef: any, params: any) {
+  if (typeof colDef.cellRenderer !== 'function') {
+    return undefined
+  }
+
+  const renderedValue = colDef.cellRenderer(params)
+  if (
+    typeof renderedValue === 'string' ||
+    typeof renderedValue === 'number' ||
+    typeof renderedValue === 'boolean'
+  ) {
+    return renderedValue
+  }
+
+  return undefined
+}
+
+function getTreeExportAmount(node: any, colDefs: any[]) {
+  const colDef = getTreeExportValueColumn(colDefs)
+  if (!colDef) {
+    return ''
+  }
+
+  const value = get(node?.data, colDef.field, '')
+  const params = {
+    node,
+    data: node?.data,
+    value,
+    valueFormatted: value,
+  }
+  const renderedValue = getTreeExportRenderedValue(colDef, params)
+  if (renderedValue !== undefined) {
+    return renderedValue
+  }
+
+  if (typeof colDef.exportValueGetter === 'function') {
+    return colDef.exportValueGetter(params)
+  }
+
+  return value ?? ''
+}
+
+function getSheetColumnWidth(width: unknown, fallbackWch: number) {
+  const numericWidth = Number(width)
+
+  return {
+    wch:
+      Number.isFinite(numericWidth) && numericWidth > 0
+        ? numericWidth
+        : fallbackWch,
+  }
+}
+
+function getExcelWidthAt(widths: unknown, index: number) {
+  if (!Array.isArray(widths) || !widths.length) {
+    return undefined
+  }
+
+  return widths[index]
+}
+
+function getTreeHierarchyColumnWidth(autoGroupColumn: any, index: number) {
+  const configuredWidths = autoGroupColumn?.excelWidths
+  return getSheetColumnWidth(
+    getExcelWidthAt(configuredWidths, index) ?? autoGroupColumn?.excelWidth,
+    32
+  )
+}
+
+function createBlankExportCells(length: number) {
+  return Array.from({ length }, () => null)
+}
+
+function getTreeExportStyleData(node: any) {
+  return (
+    node?.childrenAfterFilter?.find(
+      (child: any) => child?.data?.group_balance != null
+    )?.data || node?.data
+  )
+}
+
+function isTreeExportBoldRow(node: any) {
+  if (node?.allChildrenCount !== null && node?.uiLevel === 0) {
+    return true
+  }
+
+  return Boolean(getTreeExportStyleData(node)?.style)
+}
+
+function applyTreeExportBoldRow(
+  worksheet: Record<string, any>,
+  rowIndex: number,
+  lastColumnIndex: number
+) {
+  for (let columnIndex = 0; columnIndex <= lastColumnIndex; columnIndex++) {
+    const cell =
+      worksheet[
+        XLSX.utils.encode_cell({
+          r: rowIndex,
+          c: columnIndex,
+        })
+      ]
+
+    if (cell) {
+      cell.s = {
+        ...cell.s,
+        font: {
+          ...cell.s?.font,
+          bold: true,
+        },
+      }
+    }
+  }
+}
+
+export function exportSplitTreeDataToExcel({
+  autoGroupColumn,
+  colDefs,
+  fileName,
+  gridApi,
+  sheetName,
+}: SplitTreeDataExportParams) {
+  const nodes: Array<{ node: any; path: string[] }> = []
+
+  gridApi?.forEachNodeAfterFilterAndSort((node: any) => {
+    if (node?.footer) {
+      return
+    }
+
+    const path = getTreeExportPath(node)
+      .map((item: unknown) => getExportGroupLabel(item))
+      .filter(Boolean)
+
+    if (path.length) {
+      nodes.push({ node, path })
+    }
+  })
+
+  if (!nodes.length) {
+    return false
+  }
+
+  const hierarchyColumnCount = Math.max(
+    ...nodes.map(({ path }) => path.length),
+    1
+  )
+  const rows: unknown[][] = [
+    [
+      getTreeExportTitle(autoGroupColumn, sheetName),
+      ...createBlankExportCells(hierarchyColumnCount),
+    ],
+    ...nodes.map(({ node, path }) => {
+      const row: unknown[] = createBlankExportCells(hierarchyColumnCount + 1)
+      row[path.length - 1] = path[path.length - 1]
+      row[hierarchyColumnCount] = getTreeExportAmount(node, colDefs)
+      return row
+    }),
+  ]
+
+  const workbook = XLSX.utils.book_new()
+  const worksheet = XLSX.utils.aoa_to_sheet(rows)
+  const titleStyle = {
+    alignment: { horizontal: 'center' },
+    font: { bold: true },
+    fill: { fgColor: { rgb: 'E7ECE2' } },
+  }
+  const titleCell = worksheet[XLSX.utils.encode_cell({ r: 0, c: 0 })]
+
+  if (titleCell) {
+    titleCell.s = titleStyle
+  }
+
+  worksheet[XLSX.utils.encode_cell({ r: 0, c: hierarchyColumnCount })] = {
+    t: 's',
+    v: '',
+    s: titleStyle,
+  }
+
+  nodes.forEach(({ node }, index) => {
+    if (isTreeExportBoldRow(node)) {
+      applyTreeExportBoldRow(worksheet, index + 1, hierarchyColumnCount)
+    }
+  })
+
+  worksheet['!merges'] = [
+    {
+      s: { r: 0, c: 0 },
+      e: { r: 0, c: hierarchyColumnCount - 1 },
+    },
+  ]
+  worksheet['!cols'] = [
+    ...Array.from({ length: hierarchyColumnCount }, (_, index) =>
+      getTreeHierarchyColumnWidth(autoGroupColumn, index)
+    ),
+    getSheetColumnWidth(autoGroupColumn?.excelAmountWidth, 18),
+  ]
+  worksheet['!freeze'] = 'A2'
+
+  XLSX.utils.book_append_sheet(workbook, worksheet, sheetName)
+  XLSX.writeFile(workbook, `${fileName}.xlsx`, { cellStyles: true })
+  return true
+}
