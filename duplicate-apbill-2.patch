From bf3a043a6ec9771458f6d1816f2cfa45df577dc9 Mon Sep 17 00:00:00 2001
From: Shisun <worlddominator007@gmail.com>
Date: Sat, 6 Jun 2026 20:59:01 +0700
Subject: [PATCH] fix: duplicate recall exchange rate

---
 .../composables/useAccountPayableDuplicate.ts |  8 +++++
 .../account-payable-bill/components/Form.vue  | 30 +++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/src/modules/account-payable/composables/useAccountPayableDuplicate.ts b/src/modules/account-payable/composables/useAccountPayableDuplicate.ts
index 9a96958..66c7a85 100644
--- a/src/modules/account-payable/composables/useAccountPayableDuplicate.ts
+++ b/src/modules/account-payable/composables/useAccountPayableDuplicate.ts
@@ -26,6 +26,7 @@ const duplicateAccountPayableOmitKeys = [
   'payment_applications',
   'payment_state',
   'prepayment_amount',
+  'prepayment_balance',
   'total_after_discount',
   'total_balance',
   'total_open_balance',
@@ -39,6 +40,13 @@ const duplicateAccountPayableOmitKeys = [
   'object_id',
   'content_type',
   'external_reference',
+  'vendor_reference',
+  'transaction_date',
+  'financial_period',
+  'financial_year',
+  'due_date',
+  'exchange_rate',
+  'rate_reciprocal',
   'reversed_by',
   'reversed_date',
   'reverse_reason',
diff --git a/src/modules/account-payable/views/transaction/account-payable-bill/components/Form.vue b/src/modules/account-payable/views/transaction/account-payable-bill/components/Form.vue
index c7d75cf..8a01ec0 100644
--- a/src/modules/account-payable/views/transaction/account-payable-bill/components/Form.vue
+++ b/src/modules/account-payable/views/transaction/account-payable-bill/components/Form.vue
@@ -708,6 +708,35 @@
     }
   }
 
+  async function updateExchangeRate() {
+    if (!formData.value.currency?.id || !formData.value.rate_category?.id) {
+      formData.value.exchange_rate = null
+      formData.value.rate_reciprocal = null
+      return
+    }
+
+    try {
+      const { data } = await accountPayableService.getRateCategoryByCurrencyId({
+        from_currency_id: formData.value.currency.id,
+      })
+      const latestRateCategory = data.results.find((rateCategory) => rateCategory.id === formData.value.rate_category?.id)
+
+      if (!latestRateCategory) {
+        formData.value.exchange_rate = null
+        formData.value.rate_reciprocal = null
+        return
+      }
+
+      formData.value.rate_category = latestRateCategory
+      formData.value.exchange_rate = latestRateCategory.rate_value ?? null
+      formData.value.rate_reciprocal = latestRateCategory.rate_reciprocal ?? null
+    } catch (error) {
+      console.error('Error updating exchange rate:', error)
+      formData.value.exchange_rate = null
+      formData.value.rate_reciprocal = null
+    }
+  }
+
   function onCreatePayment() {
     const route = router.resolve({
       name: 'payment.create',
@@ -794,6 +823,7 @@
             )
             formData.value.financial_period = await findCurrentFinancialPeriod()
             await updateDueDate()
+            await updateExchangeRate()
           }
         }
         await computeItem()
