new file mode 100644
index 0000000000..0884ce7c47
--- /dev/null
+++ b/src/components/workflow/BatchApprovalAction.vue
@@ -0,0 +1,61 @@
+<template>
+    <div v-if="selectedCount" class="d-flex gap-4 mx-4">
+        <v-btn color="primary" variant="flat" @click="dialogModel = true">
+            {{ actionLabel }}
+        </v-btn>
+
+        <v-dialog v-model="dialogModel" class="position-top" width="auto" transition="slide-y-transition">
+            <v-card class="pa-4">
+                <v-card-title class="pa-0 text-h5 text-capitalize">
+                    {{ title }}
+                </v-card-title>
+
+                <v-card-text class="pa-0 mt-4 mb-2">
+                    When you click "CONFIRM",
+                    <strong class="text-primary">{{ selectedCount }} selected {{ itemLabel }}</strong>
+                    will be approved. They will disappear from the pending list once processed.
+                </v-card-text>
+
+                <v-card-actions class="pa-0 align-end">
+                    <v-spacer />
+                    <v-btn color="primary" size="small" variant="tonal" :loading="loading" @click="$emit('confirm')">
+                        Confirm
+                    </v-btn>
+                    <v-btn color="default" size="small" variant="text" :disabled="loading" @click="dialogModel = false">
+                        Discard
+                    </v-btn>
+                </v-card-actions>
+            </v-card>
+        </v-dialog>
+
+        <v-btn color="default" variant="outlined" @click="$emit('clear')"> Clear </v-btn>
+    </div>
+</template>
+
+<script lang="ts" setup>
+    import { computed } from 'vue'
+
+    const props = withDefaults(
+        defineProps<{
+            modelValue: boolean
+            selectedCount: number
+            loading?: boolean
+            actionLabel?: string
+            title?: string
+            itemLabel?: string
+        }>(),
+        {
+            loading: false,
+            actionLabel: 'Approve',
+            title: 'Batch Approve',
+            itemLabel: 'item(s)',
+        }
+    )
+
+    const emit = defineEmits(['update:modelValue', 'confirm', 'clear'])
+
+    const dialogModel = computed({
+        get: () => props.modelValue,
+        set: value => emit('update:modelValue', value),
+    })
+</script>
diff --git a/src/composables/useTransactionBatchApproval.ts b/src/composables/useTransactionBatchApproval.ts
new file mode 100644
index 0000000000..6053a4c759
--- /dev/null
+++ b/src/composables/useTransactionBatchApproval.ts
@@ -0,0 +1,90 @@
+import { computed, ref, unref, watch, type ComputedRef, type Ref } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import { workflowServices } from '@/atom/workflow/workflow.api'
+import { useCustomToast } from '@/composables/useCustomToast'
+import { POSITION, TYPE } from 'vue-toastification'
+
+type ReactiveValue<T> = T | ComputedRef<T> | Ref<T>
+
+type UseTransactionBatchApprovalOptions = {
+    contentType: ReactiveValue<string>
+    isEnabled: ComputedRef<boolean> | Ref<boolean>
+    checkedIds?: Ref<number[]>
+    resetKey?: ReactiveValue<unknown>
+    reload?: () => void
+    successMessage?: string
+    errorMessage?: string
+}
+
+export const useTransactionBatchApproval = (options: UseTransactionBatchApprovalOptions) => {
+    const {
+        contentType,
+        isEnabled,
+        resetKey,
+        reload,
+        successMessage = 'Approved success!',
+        errorMessage = 'Error during approval.',
+    } = options
+    const route = useRoute()
+    const router = useRouter()
+    const checkedIds = options.checkedIds ?? ref<number[]>([])
+    const processedTransactionIds = ref<number[]>([])
+    const popConfirm = ref(false)
+    const isApproving = ref(false)
+
+    const selectedTransactionIds = computed(() => [...new Set(checkedIds.value)])
+
+    const exclusionQueryParams = computed(() => ({
+        pk:
+            isEnabled.value && processedTransactionIds.value.length
+                ? `not_in,[${processedTransactionIds.value.join(',')}]`
+                : undefined,
+    }))
+
+    const clearSelection = () => {
+        checkedIds.value = []
+    }
+
+    const reset = () => {
+        clearSelection()
+        processedTransactionIds.value = []
+        popConfirm.value = false
+    }
+
+    const batchApprove = async () => {
+        if (!isEnabled.value || !selectedTransactionIds.value.length) return
+
+        isApproving.value = true
+        try {
+            await workflowServices.batchApproval({
+                content_type: unref(contentType),
+                transaction_ids: selectedTransactionIds.value,
+            })
+
+            processedTransactionIds.value = [
+                ...new Set([...processedTransactionIds.value, ...selectedTransactionIds.value]),
+            ]
+            clearSelection()
+            popConfirm.value = false
+            useCustomToast(TYPE.SUCCESS, POSITION.TOP_CENTER, '', successMessage, 3000)
+            await router.replace({ query: { ...route.query, page: 1 } })
+            reload?.()
+        } catch (error) {
+            useCustomToast(TYPE.ERROR, POSITION.TOP_CENTER, '', errorMessage, 3000)
+        } finally {
+            isApproving.value = false
+        }
+    }
+
+    watch(() => [isEnabled.value, resetKey ? unref(resetKey) : undefined], reset)
+
+    return {
+        checkedIds,
+        clearSelection,
+        exclusionQueryParams,
+        isApproving,
+        popConfirm,
+        batchApprove,
+        reset,
+    }
+}
